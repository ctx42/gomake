---
gomake [options] [target] [args]

The makefile is a make-like target runner.

options:
      --bin             path to put the compiled makefile in
      --check-config    validate gomake.yaml and list target config keys
      --complete        install shell completion
  -h, --help            show this help or description of the target
      --list            show available targets
      --src             path where to look for targets
      --timeout         target execution timeout (default: 0)
      --tmp             absolute path temporary directory
      --version         print version
      --wd              working directory for compiled makefile

targets:
  :panic-string
  :print                     is a test target with help message

  basic                      prints its name to stdout
  basic-args
  basic-env
  kebab-case:hello-world
  long
  ns-def
  ns-def:hello
  ns-def:world
  ns0:hello
  ns0:ns1:hello
  ns0:ns1:ns2:hello-hello
  ns0:ns1:ns2:say-my-name
  ns0:ns3:hello
  ns0:ns3:ns4:hello
  panic-string
  print-args
  say-hello
